{
  "dataset_id": "lakehouse.customer_cdf",
  "source": {
    "system": "fabric_lakehouse",
    "object": "bronze.customer",
    "connection_ref": "customer_lakehouse"
  },
  "target": {
    "layer": "silver",
    "object": "customer_history"
  },
  "load": {
    "capture_strategy": "CDC",
    "apply_strategy": "SCD2",
    "business_key": ["customer_id"],
    "merge_key": ["customer_id"],
    "tracked_columns": ["name", "segment", "status"],
    "delete_policy": "APPLY"
  },
  "orchestration": {
    "execution_group": "lakehouse_cdf",
    "retry_count": 3,
    "batch_size": 250000,
    "max_concurrency": 4
  },
  "quality": {
    "policy_name": "standard",
    "quarantine_policy": "row"
  },
  "reconciliation": {
    "policy_name": "cdc_checkpoint"
  },
  "execution": {
    "engine": "SPARK",
    "progress_owner": "FRAMEWORK",
    "capability_profile": "delta_cdf_v1",
    "apply_engine": "SPARK"
  }
}
