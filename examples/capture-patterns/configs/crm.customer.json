{
  "dataset_id": "crm.customer",
  "source": {
    "system": "crm",
    "object": "dbo.customer",
    "connection_ref": "crm_sql"
  },
  "target": {
    "layer": "silver",
    "object": "customer"
  },
  "load": {
    "capture_strategy": "WATERMARK",
    "apply_strategy": "SCD1",
    "business_key": ["customer_id"],
    "merge_key": ["customer_id"],
    "watermark": {
      "column": "updated_at",
      "tie_breaker": ["customer_id"],
      "overlap_window_seconds": 600
    },
    "event_time_column": "updated_at",
    "version_column": "row_version",
    "delete_policy": "IGNORE"
  },
  "orchestration": {
    "execution_group": "crm_incremental",
    "retry_count": 3,
    "batch_size": 100000,
    "max_concurrency": 4
  },
  "quality": {
    "policy_name": "standard",
    "quarantine_policy": "row"
  },
  "reconciliation": {
    "policy_name": "row_accounting"
  },
  "execution": {
    "engine": "FABRIC_COPY_ACTIVITY",
    "progress_owner": "FRAMEWORK",
    "apply_engine": "SPARK"
  }
}
