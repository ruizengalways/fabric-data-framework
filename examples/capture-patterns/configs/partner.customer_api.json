{
  "dataset_id": "partner.customer_api",
  "source": {
    "system": "partner_api",
    "object": "/v1/customers/changes",
    "connection_ref": "partner_customer_api"
  },
  "target": {
    "layer": "silver",
    "object": "partner_customer"
  },
  "load": {
    "capture_strategy": "WATERMARK",
    "apply_strategy": "SCD1",
    "business_key": ["customer_id"],
    "merge_key": ["customer_id"],
    "watermark": {
      "column": "changed_at",
      "tie_breaker": ["customer_id"],
      "overlap_window_seconds": 300
    },
    "event_time_column": "changed_at",
    "version_column": "version",
    "delete_policy": "IGNORE"
  },
  "orchestration": {
    "execution_group": "partner_api",
    "retry_count": 4,
    "batch_size": 50000,
    "max_concurrency": 2
  },
  "quality": {
    "policy_name": "standard",
    "quarantine_policy": "row"
  },
  "reconciliation": {
    "policy_name": "row_accounting"
  },
  "execution": {
    "engine": "SPARK",
    "progress_owner": "FRAMEWORK",
    "apply_engine": "SPARK"
  }
}
